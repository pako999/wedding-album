# Guestcam environment template
# Never commit real production secrets. Values below are placeholders only.

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.guestcam.si
NODE_ENV=development

# ── Clerk authentication ──────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Database (Neon PostgreSQL) ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ── Admin security (required in production) ────────────────────────────────────
# Comma-separated verified admin email addresses.
ADMIN_EMAILS=admin@example.com
# Second factor used by the admin surface. Production access fails closed when
# this is missing.
ADMIN_PASSWORD=replace-with-a-long-random-secret

# ── Bunny legacy Storage ───────────────────────────────────────────────────────
# KEEP these while historical albums still contain legacy Bunny Storage files.
BUNNY_STORAGE_ZONE=frank1
BUNNY_STORAGE_API_KEY=legacy-storage-api-key
# Historical pull zone only. Do NOT point this at the new S3 pull zone.
BUNNY_CDN_URL=https://frfr1.b-cdn.net

# ── Bunny S3 (primary photo storage) ───────────────────────────────────────────
BUNNY_S3_ENDPOINT=https://de-s3.storage.bunnycdn.com
BUNNY_S3_REGION=de
BUNNY_S3_BUCKET=s3-guestcam
BUNNY_S3_ACCESS_KEY=s3-guestcam
BUNNY_S3_SECRET_KEY=replace-with-bunny-s3-password
# Pull zone connected to the S3 storage zone.
BUNNY_S3_CDN_URL=https://guestcam-media.b-cdn.net

# ── Bunny Stream (video uploads/playback) ──────────────────────────────────────
BUNNY_STREAM_LIBRARY_ID=123456
BUNNY_STREAM_API_KEY=replace-with-stream-api-key
# Stream CDN hostname, normally vz-....b-cdn.net
BUNNY_STREAM_CDN_URL=https://vz-example.b-cdn.net
# Required when Bunny Stream token authentication is enabled.
BUNNY_STREAM_SECURITY_KEY=replace-with-stream-token-key

# ── Distributed rate limiting ──────────────────────────────────────────────────
# Preferred names used by Guestcam. Upstash/Vercel KV equivalents are also
# supported by lib/rate-limit.ts.
RATE_LIMIT_REDIS_URL=https://example.upstash.io
RATE_LIMIT_REDIS_TOKEN=replace-with-redis-rest-token
# Optional compatible aliases:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Cloudflare Turnstile ───────────────────────────────────────────────────────
# Server-side verification fails closed in production when protected forms are
# configured to use Turnstile.
CF_TURNSTILE_SECRET_KEY=replace-with-turnstile-secret
# Legacy alias still accepted for compatibility:
# TURNSTILE_SECRET_KEY=

# ── Email (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM=Guestcam <hello@guestcam.si>

# ── Mollie payments ────────────────────────────────────────────────────────────
MOLLIE_API_KEY=test_...

# ── Paddle (legacy/alternate payments) ─────────────────────────────────────────
PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_ENV=sandbox
PADDLE_API_KEY=pdl_sdbx_apikey_...
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...

# ── Google Drive export ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# ── Scheduled jobs / explicit migrations ───────────────────────────────────────
CRON_SECRET=replace-with-cron-secret
MIGRATE_SECRET=replace-with-migration-secret

# ── WedFlow integration (legacy/partner integration) ───────────────────────────
WEDFLOW_API_KEY=replace-with-integration-key

# ── Meta analytics / advertising ───────────────────────────────────────────────
NEXT_PUBLIC_FB_PIXEL_ID=000000000000000
META_CAPI_ACCESS_TOKEN=replace-with-meta-capi-token
# Optional Meta test mode:
# META_CAPI_TEST_EVENT_CODE=TEST12345

# ── AI film / montage ──────────────────────────────────────────────────────────
KLING_ACCESS_KEY=replace-with-kling-access-key
KLING_SECRET_KEY=replace-with-kling-secret-key
SHOTSTACK_API_KEY=replace-with-shotstack-api-key
# Optional custom soundtrack URL:
# FILM_SOUNDTRACK_URL=https://example.com/audio.mp3

# ── Notifications ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-chat-id

# ── Historical providers — only if old records still require them ──────────────
# Vercel Blob writes are retired in current Guestcam production. Keep the token
# only while historical objects or a controlled migration still require it.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Cloudflare R2 is no longer the primary write path. Configure only when old
# records still need R2 compatibility.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=
# CLOUDFLARE_R2_PUBLIC_URL=https://example.r2.dev
