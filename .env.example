# ─────────────────────────────────────────────────────────────────────────────
# Guestcam environment variables.
# Copy to .env.local and fill in. Never commit real secrets.
# Generated from the variables the code actually reads; grouped by concern.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL=                       # Neon Postgres connection string
NEXT_PUBLIC_APP_URL=                # e.g. https://www.guestcam.si (canonical, no trailing slash)

# ── Auth (Clerk) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=                   # also HMAC secret for admin cookie + OAuth state
CLERK_WEBHOOK_SECRET=               # Svix signing secret; webhook fails closed if unset
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_EMAILS=                       # comma-separated allowlist
ADMIN_PASSWORD=                     # second factor for /admin

# ── Storage: Bunny ───────────────────────────────────────────────────────────
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_ZONE=
BUNNY_CDN_URL=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_CDN_URL=
BUNNY_STREAM_SECURITY_KEY=

# ── Payments (Mollie) ────────────────────────────────────────────────────────
MOLLIE_API_KEY=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=
RESEND_FROM_EMAIL=
CONTACT_RECIPIENT_EMAIL=

# ── Cron / migrations (Bearer <SECRET>, fail closed if unset) ────────────────
CRON_SECRET=
MIGRATE_SECRET=

# ── Anti-abuse (Cloudflare Turnstile) ────────────────────────────────────────
# Contact form widget:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Album comment widget (AlbumGuestView reads the CF_-prefixed public key; the
# comments route verifies with CF_TURNSTILE_SECRET_KEY). If you set the secret
# you MUST also set this public key or album comments break.
NEXT_PUBLIC_CF_TURNSTILE_SITE_KEY=
CF_TURNSTILE_SECRET_KEY=

# ── Google Drive export (OAuth) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Analytics / pixels (optional) ────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=

# ── Affiliate program (optional tuning) ──────────────────────────────────────
AFFILIATE_COMMISSION_LOCK_DAYS=
AFFILIATE_MIN_PAYOUT=

# ── Film Studio (optional; Premium AI film feature) ──────────────────────────
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
SHOTSTACK_API_KEY=
FILM_SOUNDTRACK_URL=

# ── Cloudflare R2 / Stream (optional fallback storage) ───────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_STREAM_TOKEN=

# ── Vercel Blob (optional last-resort upload fallback) ───────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Integrations (optional) ──────────────────────────────────────────────────
WEDFLOW_API_KEY=                    # x-api-key gate for /api/integrations + wedflow webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
